# Text captures are private by default; keep only known source manifests/prompts.
*.txt
!requirements*.txt
!prompt.txt
!prompt.en.txt
!prompt.nene.txt
!UPSTREAM_COMMIT.txt
!licenses/**/*.txt
# JSON defaults to private/generated; only authored motion curves are public.
*.json
!assets/motions/*.motion3.json

